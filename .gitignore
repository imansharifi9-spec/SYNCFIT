# .gitignore

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Secrets — never commit
.env
.env.*
ios/Secrets.xcconfig
*.pem
credentials.json

# Dependencies (when code is added)
node_modules/
dist/
build/
.next/

# Xcode
ios/**/DerivedData/
ios/**/*.xcuserstate
ios/**/xcuserdata/
*.ipa
*.dSYM.zip

# Logs
*.log

# Local screenshot dumps / Firebase CLI cache (never track)
tmp-cta-green/
tmp-orb-preview/
.firebase/
