rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // App writes coach_clients/{sorted(clientUid, coachUid)}.
    // Firebase Auth UIDs never contain underscores, so split is safe.
    function connectionDocId(clientId, coachId) {
      return clientId <= coachId
        ? clientId + '_' + coachId
        : coachId + '_' + clientId;
    }

    function connectionIdIncludesUid(connectionId, uid) {
      return connectionId is string
        && connectionId.split('_').size() == 2
        && uid in connectionId.split('_');
    }

    function coachClientConnection(clientId) {
      return get(
        /databases/$(database)/documents/coach_clients/$(connectionDocId(clientId, request.auth.uid))
      );
    }

    // Active coach↔client edge for the signed-in coach.
    // Missing status is treated as active (matches app decode default).
    // Never read conn.data.status unless the key exists — missing fields error.
    function isActiveCoachForClient(clientId) {
      let conn = coachClientConnection(clientId);
      return isSignedIn()
        && conn.exists
        && conn.data.keys().hasAll(['coachId'])
        && conn.data.coachId == request.auth.uid
        && (
          !conn.data.keys().hasAll(['status'])
          || conn.data.status == 'active'
        )
        && (
          (conn.data.keys().hasAll(['clientUserID']) && conn.data.clientUserID == clientId)
          || (conn.data.keys().hasAll(['clientId']) && conn.data.clientId == clientId)
        );
    }

    // Sharing toggles on coach_clients/{id}:
    //   permissions: { workouts, nutrition, progress }  (preferred)
    //   shareWorkouts / shareNutrition / shareProgress  (legacy flat)
    // IMPORTANT: never read conn.data.permissions.X unless permissions is a map —
    // a missing nested field errors and fails the whole allow expression.
    function coachHasSharePermission(conn, permission) {
      let hasMap = conn.data.keys().hasAll(['permissions'])
        && conn.data.permissions is map;
      let mapAllows = hasMap
        && permission in conn.data.permissions
        && conn.data.permissions[permission] == true;
      let flatAllows =
        (permission == 'workouts'
          && conn.data.keys().hasAll(['shareWorkouts'])
          && conn.data.shareWorkouts == true)
        || (permission == 'nutrition'
          && conn.data.keys().hasAll(['shareNutrition'])
          && conn.data.shareNutrition == true)
        || (permission == 'progress'
          && conn.data.keys().hasAll(['shareProgress'])
          && conn.data.shareProgress == true);
      return mapAllows || flatAllows;
    }

    function coachCanReadClientData(clientId, permission) {
      let conn = coachClientConnection(clientId);
      return isActiveCoachForClient(clientId)
        && coachHasSharePermission(conn, permission);
    }

    // Chat — signed-in user must be one of the two participants on the doc.
    function isConversationWriteAllowed() {
      return request.auth != null
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.userId is string
        && request.resource.data.coachId is string
        && request.resource.data.userId != request.resource.data.coachId
        && request.resource.data.userId in request.resource.data.participants
        && request.resource.data.coachId in request.resource.data.participants
        && (request.auth.uid == request.resource.data.userId
          || request.auth.uid == request.resource.data.coachId);
    }

    function isConversationReadAllowed() {
      return request.auth != null
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;
    }

    // Doc id must be "{uidA}_{uidB}" in either order (app uses sorted join).
    function conversationIdMatchesParties(conversationId) {
      return conversationId == request.resource.data.userId + '_' + request.resource.data.coachId
        || conversationId == request.resource.data.coachId + '_' + request.resource.data.userId;
    }

    // Conversation ids are "{uidA}_{uidB}" (Firebase UIDs have no underscores).
    function uidInConversationId(conversationId) {
      return request.auth != null
        && conversationId is string
        && conversationId.split('_').size() == 2
        && request.auth.uid in conversationId.split('_');
    }

    // Legacy coach_messages: sender must be a named party; both UIDs required.
    function canWriteLegacyCoachMessage() {
      return request.auth != null
        && request.resource.data.coachId is string
        && request.resource.data.clientUserID is string
        && request.resource.data.coachId != request.resource.data.clientUserID
        && (request.auth.uid == request.resource.data.coachId
          || request.auth.uid == request.resource.data.clientUserID);
    }

    // User profile and scoped logs — owner R/W; linked coach read-only by permission.
    match /users/{userId} {
      // Profile: any active coach may read (client portal needs name/targets).
      //
      // TODO(subscription): Lock `subscriptionStatus` / `subscriptionExpiresAt` writes to
      // Cloud Functions only once server-side StoreKit receipt verification ships. Until
      // then, the client (SubscriptionManager) may write those fields as owner.
      //
      // TODO(subscription): Firestore cannot hide individual fields on a readable doc.
      // Coaches who pass isActiveCoachForClient currently receive the whole users/{uid}
      // document including subscription fields. For true owner-only read of subscription
      // data, move those fields to users/{userId}/private/subscription (or similar) and
      // allow read: if isOwner(userId) only.
      allow read: if isOwner(userId) || isActiveCoachForClient(userId);
      allow create, update, delete: if isOwner(userId);

      match /weights/{docId} {
        allow read, write: if isOwner(userId);
        allow read: if coachCanReadClientData(userId, 'progress');
      }

      match /meals/{docId} {
        allow read, write: if isOwner(userId);
        allow read: if coachCanReadClientData(userId, 'nutrition');
      }

      match /workouts/{docId} {
        allow get, list, create, update, delete: if isOwner(userId);
        allow get, list: if coachCanReadClientData(userId, 'workouts');
      }

      // Progress photo metadata (image bytes live in Firebase Storage).
      match /progress_photos/{docId} {
        allow get, list, create, update, delete: if isOwner(userId);
        allow get, list: if coachCanReadClientData(userId, 'progress');
      }

      // Routine library — schedule slots store customRoutineID pointing here.
      match /routines/{docId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }

      // Any other user subcollections stay owner-only.
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Coach access codes. Codes are stored hashed; still restrict reads to own codes
    // or the shared DEV seed document. Activation may only touch activatedAt.
    match /coach_codes/{codeId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || codeId == 'dev_code');

      // DEV ONLY: client-side seed helper for `dev_code` — remove before production.
      allow create, update: if isSignedIn() && codeId == 'dev_code';

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.isActive == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activatedAt'])
        && request.resource.data.activatedAt != null;

      allow delete: if false;
    }

    // Marketplace coach profiles — signed-in read; coach writes own doc only.
    // Stripe Connect fields are Admin SDK (Cloud Functions) only — never client-writable.
    match /coaches/{coachId} {
      function coachStripeFieldsAbsentOnCreate() {
        return !request.resource.data.keys().hasAny([
          'stripeConnectedAccountId',
          'stripeChargesEnabled',
          'stripePayoutsEnabled',
          'stripeUpdatedAt'
        ]);
      }

      function coachStripeFieldsUnchangedOnUpdate() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'stripeConnectedAccountId',
            'stripeChargesEnabled',
            'stripePayoutsEnabled',
            'stripeUpdatedAt'
          ]);
      }

      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && coachId == request.auth.uid
        && request.resource.data.coachId == request.auth.uid
        && coachStripeFieldsAbsentOnCreate();

      allow update: if isSignedIn()
        && coachId == request.auth.uid
        && resource.data.coachId == request.auth.uid
        && request.resource.data.coachId == request.auth.uid
        && coachStripeFieldsUnchangedOnUpdate();

      allow delete: if isSignedIn()
        && coachId == request.auth.uid
        && resource.data.coachId == request.auth.uid;

      match /routine_templates/{templateId} {
        allow read, write: if isSignedIn() && request.auth.uid == coachId;
      }
    }

    // Stripe webhook idempotency ledger — Admin SDK only.
    match /stripeWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    // Coach ↔ client connections. Only participants may create/update their own edge.
    match /coach_clients/{connectionId} {
      // CRITICAL: gets on a missing doc still evaluate this rule with resource == null.
      // `resource.data.coachId` errors → deny, which blocked ensureCanonical from
      // discovering the doc was missing and creating the canonical edge.
      // Allow get when the sorted id names the signed-in user (client or coach).
      allow get: if isSignedIn()
        && connectionIdIncludesUid(connectionId, request.auth.uid)
        && (
          !exists(/databases/$(database)/documents/coach_clients/$(connectionId))
          || request.auth.uid == resource.data.coachId
          || request.auth.uid == resource.data.clientId
          || request.auth.uid == resource.data.clientUserID
        );

      allow list: if isSignedIn()
        && (request.auth.uid == resource.data.coachId
          || request.auth.uid == resource.data.clientId
          || request.auth.uid == resource.data.clientUserID);

      // Client hire flow OR coach repair of the canonical sorted-id doc.
      // Both parties must be named; doc id must match sorted(client, coach).
      allow create: if isSignedIn()
        && request.resource.data.coachId is string
        && request.resource.data.clientUserID is string
        && request.resource.data.clientId is string
        && request.resource.data.clientId == request.resource.data.clientUserID
        && connectionId == connectionDocId(
          request.resource.data.clientUserID,
          request.resource.data.coachId
        )
        && (
          request.auth.uid == request.resource.data.clientUserID
          || request.auth.uid == request.resource.data.coachId
        );

      allow update: if isSignedIn()
        && (request.auth.uid == resource.data.clientId
          || request.auth.uid == resource.data.clientUserID
          || request.auth.uid == resource.data.coachId
          || (
            request.auth.uid == request.resource.data.coachId
            && connectionIdIncludesUid(connectionId, request.auth.uid)
          ))
        && request.resource.data.clientUserID == resource.data.clientUserID
        && request.resource.data.clientId == resource.data.clientId
        && (
          request.resource.data.coachId == resource.data.coachId
          || request.resource.data.coachId == request.auth.uid
        );

      allow delete: if false;
    }

    // Chat threads — ONLY participants listed on the conversation doc.
    match /conversations/{conversationId} {
      allow read: if isConversationReadAllowed();

      allow create: if isConversationWriteAllowed()
        && conversationIdMatchesParties(conversationId);

      allow update: if isConversationReadAllowed()
        && isConversationWriteAllowed()
        && conversationIdMatchesParties(conversationId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.coachId == resource.data.coachId;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if uidInConversationId(conversationId);

        allow create: if uidInConversationId(conversationId)
          && request.resource.data.senderId is string
          && request.resource.data.senderId == request.auth.uid;

        allow update: if uidInConversationId(conversationId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isRead', 'routineCardJSON', 'text']);

        allow delete: if false;
      }
    }

    // Legacy coach messages — both parties required; no anonymous forge.
    match /coach_messages/{messageId} {
      allow read: if isSignedIn()
        && resource.data.coachId is string
        && resource.data.clientUserID is string
        && (request.auth.uid == resource.data.coachId
          || request.auth.uid == resource.data.clientUserID);

      allow create: if canWriteLegacyCoachMessage();

      allow update, delete: if false;
    }
  }
}
