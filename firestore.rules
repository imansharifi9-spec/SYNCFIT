rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function connectionDocId(clientId, coachId) {
      return clientId <= coachId
        ? clientId + '_' + coachId
        : coachId + '_' + clientId;
    }

    function coachClientConnection(clientId) {
      return get(
        /databases/$(database)/documents/coach_clients/$(connectionDocId(clientId, request.auth.uid))
      );
    }

    function isActiveCoachForClient(clientId) {
      let conn = coachClientConnection(clientId);
      return conn.exists
        && conn.data.status == 'active'
        && conn.data.coachId == request.auth.uid;
    }

    function coachCanReadClientData(clientId, permission) {
      let conn = coachClientConnection(clientId);
      // Guard map access so a missing permissions field cannot throw and
      // poison an `isOwner || coachCanRead…` evaluation for the owner path.
      return isActiveCoachForClient(clientId)
        && conn.data.keys().hasAll(['permissions'])
        && conn.data.permissions is map
        && permission in conn.data.permissions
        && conn.data.permissions[permission] == true;
    }

    function isConversationParticipant() {
      return isSignedIn() && request.auth.uid in resource.data.participants;
    }

    function createsOwnConversation() {
      return isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
    }

    function isMessageThreadParticipant() {
      return isSignedIn()
        && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.participants;
    }

    // User profile and scoped logs — owner R/W; linked coach read-only by permission.
    match /users/{userId} {
      // Profile: any active coach may read (client portal needs name/targets).
      // Subcollections below stay gated by share permissions.
      allow read: if isOwner(userId) || isActiveCoachForClient(userId);
      allow create, update, delete: if isOwner(userId);

      match /weights/{docId} {
        // Owner first (path-only) so list/listen never depends on coach get().
        allow read, write: if isOwner(userId);
        allow read: if coachCanReadClientData(userId, 'progress');
      }

      match /meals/{docId} {
        allow read, write: if isOwner(userId);
        allow read: if coachCanReadClientData(userId, 'nutrition');
      }

      match /workouts/{docId} {
        // Owner create/update/delete/list — path uid must match auth.uid.
        // Explicit write ops (not only read) so scheduled day-plan docs can persist.
        allow get, list, create, update, delete: if isOwner(userId);
        allow read: if coachCanReadClientData(userId, 'workouts');
      }

      // Routine library — schedule slots store customRoutineID pointing here.
      // This is the PART2 content write for Custom days.
      match /routines/{docId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }

      // Any other user subcollections stay owner-only.
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Coach access codes. Codes are stored hashed; still restrict reads to own codes
    // or the shared DEV seed document. Activation may only touch activatedAt.
    match /coach_codes/{codeId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || codeId == 'dev_code');

      // DEV ONLY: client-side seed helper for `dev_code` — remove before production.
      allow create, update: if isSignedIn() && codeId == 'dev_code';

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.isActive == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activatedAt'])
        && request.resource.data.activatedAt != null;

      allow delete: if false;
    }

    // Marketplace coach profiles — signed-in read; coach writes own doc only.
    match /coaches/{coachId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && coachId == request.auth.uid
        && request.resource.data.coachId == request.auth.uid;

      allow update, delete: if isSignedIn()
        && coachId == request.auth.uid
        && resource.data.coachId == request.auth.uid;

      match /routine_templates/{templateId} {
        allow read, write: if isSignedIn() && request.auth.uid == coachId;
      }
    }

    // Coach ↔ client connections. Only participants may create/update their own edge.
    match /coach_clients/{connectionId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.coachId
          || request.auth.uid == resource.data.clientId
          || request.auth.uid == resource.data.clientUserID);

      // Only the client may create the connection (hire flow). Coaches must not
      // self-attach to arbitrary client UIDs.
      allow create: if isSignedIn()
        && request.resource.data.coachId is string
        && request.resource.data.clientUserID is string
        && request.resource.data.clientId is string
        && request.resource.data.clientId == request.resource.data.clientUserID
        && request.auth.uid == request.resource.data.clientUserID
        && connectionId == connectionDocId(
          request.resource.data.clientUserID,
          request.resource.data.coachId
        );

      allow update: if isSignedIn()
        && (request.auth.uid == resource.data.clientId
          || request.auth.uid == resource.data.clientUserID
          || request.auth.uid == resource.data.coachId)
        && request.resource.data.coachId == resource.data.coachId
        && request.resource.data.clientUserID == resource.data.clientUserID
        && request.resource.data.clientId == resource.data.clientId;

      allow delete: if false;
    }

    // Chat threads — only listed participants.
    match /conversations/{conversationId} {
      allow read: if isConversationParticipant();

      allow create: if createsOwnConversation()
        && request.resource.data.userId is string
        && request.resource.data.coachId is string
        && request.auth.uid in [
          request.resource.data.userId,
          request.resource.data.coachId
        ]
        && conversationId == connectionDocId(
          request.resource.data.userId,
          request.resource.data.coachId
        );

      // Participants cannot rewrite the membership edge.
      allow update: if isConversationParticipant()
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.coachId == resource.data.coachId;

      match /messages/{messageId} {
        allow read: if isMessageThreadParticipant();

        allow create: if isMessageThreadParticipant()
          && request.resource.data.senderId == request.auth.uid;

        // Participants may update read receipts / routine-card payload fields.
        allow update: if isMessageThreadParticipant()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isRead', 'routineCardJSON', 'text']);

        allow delete: if false;
      }
    }

    // Legacy coach messages collection — sender must be a named party.
    match /coach_messages/{messageId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.coachId
          || request.auth.uid == resource.data.clientUserID);

      allow create: if isSignedIn()
        && request.resource.data.coachId is string
        && request.resource.data.clientUserID is string
        && (request.auth.uid == request.resource.data.coachId
          || request.auth.uid == request.resource.data.clientUserID);

      allow update, delete: if false;
    }
  }
}
